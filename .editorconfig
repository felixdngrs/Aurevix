# Aurevix EditorConfig
# Consistent formatting across editors and development environments.
# https://editorconfig.org/

root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C source files and headers
# Detailed formatting rules are defined in .clang-format.
[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

# AArch64 assembly source files
[*.{S,s,asm}]
indent_style = space
indent_size = 4
max_line_length = 100

# GNU linker scripts
[*.{ld,lds}]
indent_style = space
indent_size = 4
max_line_length = 100

# Makefiles require tabs for recipe commands.
[Makefile]
indent_style = tab
tab_width = 4

[*.mk]
indent_style = tab
tab_width = 4

# YAML configuration files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON configuration files
[*.json]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = off
